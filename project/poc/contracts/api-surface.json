{
  "contractVersion": "2026-05-poc",
  "pluginVersion": "0.1.0",
  "baseUrl": "http://localhost:8000",
  "auth": {
    "authenticatedHeader": "Authorization: Bearer demo_plugin_session",
    "adminHeader": "X-Admin-Token: demo_admin_session",
    "modelBackedWriteHeaders": ["Authorization", "Idempotency-Key"]
  },
  "routes": [
    { "method": "GET", "path": "/health", "auth": false },
    { "method": "POST", "path": "/auth/plugin/start", "auth": false },
    { "method": "POST", "path": "/auth/plugin/exchange", "auth": false },
    { "method": "GET", "path": "/me/context", "auth": true },
    { "method": "GET", "path": "/admin/tenants", "auth": "admin" },
    { "method": "POST", "path": "/admin/tenants", "auth": "admin" },
    { "method": "POST", "path": "/admin/tenants/{tenantId}/brands", "auth": "admin" },
    { "method": "POST", "path": "/tenants/{tenantId}/brands/{brandId}/guidelines", "auth": true, "contentType": "multipart/form-data" },
    { "method": "GET", "path": "/tenants/{tenantId}/brands/{brandId}/profiles", "auth": true },
    { "method": "GET", "path": "/tenants/{tenantId}/brands/{brandId}/profiles/{profileId}", "auth": true },
    { "method": "POST", "path": "/tenants/{tenantId}/brands/{brandId}/profiles/{profileId}/approve", "auth": true },
    { "method": "GET", "path": "/fixtures/figma-selection", "auth": false },
    { "method": "POST", "path": "/quality/model-gateway/evaluate", "auth": true, "qualityGate": true },
    { "method": "POST", "path": "/plugin/copy/generate", "auth": true, "modelBacked": true },
    { "method": "POST", "path": "/plugin/copy/localize", "auth": true, "modelBacked": true },
    { "method": "POST", "path": "/plugin/images/jobs", "auth": true, "modelBacked": true, "policyChecked": true },
    { "method": "GET", "path": "/plugin/images/jobs/{jobId}", "auth": true, "assetMetadata": ["placeholderOnly", "rightsStatus", "safetyStatus", "policyChecks"] },
    { "method": "GET", "path": "/assets/{assetId}.png", "auth": false, "contentType": "image/png" },
    { "method": "POST", "path": "/plugin/apply-events", "auth": true },
    { "method": "GET", "path": "/reports/usage", "auth": true }
  ],
  "stableIds": {
    "tenantId": "tenant_designtechco",
    "secondaryTenantId": "tenant_studioarc",
    "userId": "usr_maya",
    "brandId": "brand_nova",
    "profileId": "profile_nova_v3",
    "selectionId": "sel_spring_launch",
    "profileListRequestId": "req_profiles_list_001",
    "profileApproveRequestId": "req_profile_approve_001",
    "copyOperationId": "op_copy_001",
    "copyRequestId": "req_copy_001",
    "copyUsageEventId": "usage_copy_001",
    "modelQualityRunId": "quality_run_001",
    "authState": "state_demo",
    "pkceVerifier": "demo_code_verifier",
    "localizationOperationId": "op_loc_001",
    "localizationRequestId": "req_loc_001",
    "localizationUsageEventId": "usage_loc_001",
    "imageJobId": "job_img_001",
    "imageUsageEventId": "usage_img_001",
    "assetId": "asset_img_001",
    "applyEventId": "apply_001",
    "applyAuditEventId": "audit_apply_001"
  }
}
